{
  "name": "xaku-tui",
  "version": "0.1.0",
  "description": "Terminal workspace for chatting with, stress-testing, and reviewing local Ollama models.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "runxaku": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ollama",
    "tui",
    "benchmark",
    "tools",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "env-paths": "^3.0.0",
    "highlight.js": "^11.12.0",
    "ink": "^5.0.1",
    "marked": "^18.1.1",
    "openai": "^4.68.4",
    "react": "^18.3.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.7.9",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
